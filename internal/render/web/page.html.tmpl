<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap">
<link rel="stylesheet" href="/static/css/tokens.css">
<link rel="stylesheet" href="/static/css/layouts.css">
<link rel="stylesheet" href="/static/css/viewer.css">
</head>
<body>
<div id="stage">
<div id="deck">
{{range $i, $s := .Screens}}<section class="screen layout-{{$s.Layout}}{{if $s.ImagesFirst}} images-first{{end}}" data-index="{{$i}}">
{{if $s.Heading}}<h1 class="screen-heading">{{$s.Heading}}</h1>{{end}}
<div class="screen-body">
{{if $s.ContentHTML}}<div class="screen-content">{{$s.ContentHTML}}</div>{{end}}
{{if $s.Images}}<div class="screen-images">{{range $s.Images}}<img src="{{.Src}}" alt="{{.Alt}}">{{end}}</div>{{end}}
</div>
</section>
{{end}}</div>
</div>
<div id="hud">
<button id="theme-toggle" type="button" aria-label="Toggle light/dark theme">&#9789;</button>
<span id="counter"></span>
</div>
<script type="module" src="/static/js/main.js"></script>
</body>
</html>
